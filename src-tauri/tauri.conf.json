{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Worker",
  "version": "0.1.22",
  "identifier": "com.localai.worker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local AI Worker",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "digestAlgorithm": "sha256"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NzVGNTMyNDJDMzhFQTIKUldTaWpzTkNNdlYxdGI3eEZtc0JRT3l1amw2aitpeVd3WHBxa3RKcTNPck9aWG5wcUFrQ1lHeEIK",
      "endpoints": [
        "https://github.com/MichaelJ43/local-ai-worker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
