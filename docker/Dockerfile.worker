# Build from repository root: docker build -f docker/Dockerfile.worker -t local-ai-worker-agent:latest .
# syntax=docker/dockerfile:1

FROM rust:1.86-bookworm AS builder
WORKDIR /build
COPY crates/ai_worker_core crates/ai_worker_core
COPY docs/rules/rules-tree.json docs/rules/rules-tree.json
RUN cargo build --release --manifest-path crates/ai_worker_core/Cargo.toml --bin worker-guard

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y gh && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/crates/ai_worker_core/target/release/worker-guard /opt/ai-worker/bin/worker-guard
RUN chmod +x /opt/ai-worker/bin/worker-guard

COPY docker/git-wrap.sh /opt/ai-worker/bin/git
COPY docker/gh-wrap.sh /opt/ai-worker/bin/gh
RUN chmod +x /opt/ai-worker/bin/git /opt/ai-worker/bin/gh

COPY docker/repo_sandbox_writes.sh /opt/ai-worker/scripts/repo_sandbox_writes.sh
COPY docker/worker-agent-common.sh /opt/ai-worker/scripts/worker-agent-common.sh
COPY docker/agent-loop.sh /opt/ai-worker/scripts/agent-loop.sh
COPY docker/repo-agent-loop.sh /opt/ai-worker/scripts/repo-agent-loop.sh
COPY docker/entrypoint.sh /opt/ai-worker/entrypoint.sh
RUN chmod +x /opt/ai-worker/scripts/agent-loop.sh /opt/ai-worker/scripts/repo-agent-loop.sh /opt/ai-worker/entrypoint.sh

ENV PATH="/opt/ai-worker/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
WORKDIR /workspace

ENTRYPOINT ["/opt/ai-worker/entrypoint.sh"]
