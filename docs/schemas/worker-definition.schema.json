{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-worker.local/worker-definition.schema.json",
  "title": "WorkerDefinition",
  "type": "object",
  "required": ["id", "name", "maintenanceDomain", "enabled", "tasks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "maintenanceDomain": { "type": "string" },
    "escalationPath": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modelOverride": { "type": ["string", "null"] },
    "ollamaHost": { "type": ["string", "null"] },
    "enabled": { "type": "boolean" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "schedule"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "schedule": {
            "oneOf": [
              { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "oneShot" } } },
              {
                "type": "object",
                "required": ["kind", "intervalSeconds"],
                "properties": {
                  "kind": { "const": "cadence" },
                  "intervalSeconds": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "guardrailOverrides": {},
    "contextPath": { "type": ["string", "null"] },
    "longTermVolume": { "type": ["string", "null"] },
    "dockerImage": { "type": ["string", "null"] },
    "envFromSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["envVar", "secretKey"],
        "properties": {
          "envVar": { "type": "string", "minLength": 1 },
          "secretKey": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "workerPrompt": { "type": ["string", "null"] },
    "hybridOptions": {
      "type": ["object", "null"],
      "properties": {
        "cursorSecretKey": { "type": ["string", "null"] },
        "repoUrl": { "type": ["string", "null"] },
        "startingRef": { "type": ["string", "null"] },
        "workspacePath": { "type": ["string", "null"] },
        "allowCloudEscalation": { "type": "boolean" },
        "localPhaseTimeoutMs": { "type": ["integer", "null"], "minimum": 1 },
        "localMaxAttempts": { "type": ["integer", "null"], "minimum": 1 },
        "cursorModelId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
