{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-worker.local/worker-context.schema.json",
  "title": "WorkerContext",
  "description": "Matches serde default (snake_case) JSON from ai_worker_core::WorkerContext.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "goals": { "type": "array", "items": { "type": "string" } },
    "facts_learned": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "last_summary": { "type": "string" },
    "last_guardrail_block": { "type": ["string", "null"] },
    "extra": {}
  },
  "additionalProperties": true
}
